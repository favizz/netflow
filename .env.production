# Production Environment Variables mapped to VPS Docker

# Database Details (TimescaleDB inside Docker, replacing localhost)
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=ta_user
DB_PASSWORD=strongpassword
DB_NAME=taflow

# Note: CloudPanel MySQL credentials are ignored as per instructions.

# Secret Configurations for NestJS
JWT_SECRET=production_strong_secret_here
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
OWNER_LOGIN_PIN=123456
ADMIN_API_KEY=production_admin_key
PAYMENT_WEBHOOK_SECRET=your_production_webhook_secret
PAYMENT_WEBHOOK_MAX_SKEW_MS=300000

# Mobile/Dashboard variables (if built into Vite/Next.js at build time, these might need to be passed into the compose file or Next config explicitly)
VITE_API_BASE_URL=https://ta252601002.srsun.id/api
VITE_MQTT_BROKER_URL=wss://ta252601002.srsun.id/mqtt
