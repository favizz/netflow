# =============================================
# TA-Flowmeter — Environment Variable Template
# Copy this file to .env and fill in your values.
# The single .env at the root is shared by all
# services (backend-ta, frontend-ta/dashboard,
# frontend-ta/mobile) via each app's envDir config.
# =============================================

# ── Backend: App Server ───────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Backend: Database (native MySQL 8.0) ─────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=ta_db

# ── Backend: MQTT Broker ──────────────────────
# TCP connection used by the NestJS backend & simulator script.
# Public test broker (no auth):  mqtt://broker.emqx.io:1883
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883

# ── Backend: Auth (JWT) ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# ── Backend: Google OAuth ─────────────────────
# Obtain from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=replace-with-google-client-id

# ── Backend: Admin ────────────────────────────
# API key required for all /admin/* endpoints (x-api-key header)
ADMIN_API_KEY=replace-with-strong-admin-key

# ── Backend: Payment Webhook ──────────────────
PAYMENT_WEBHOOK_SECRET=replace-with-strong-webhook-secret
PAYMENT_WEBHOOK_MAX_SKEW_MS=300000
# Comma-separated trusted source IPs; leave empty to allow all in local dev
PAYMENT_WEBHOOK_ALLOWED_IPS=

# ── Frontend: Mobile & Dashboard (Vite) ───────
# WebSocket MQTT connection used by the browser frontends.
# Public test broker (no auth):  ws://broker.emqx.io:8083/mqtt
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
VITE_MQTT_BROKER_URL=ws://broker.emqx.io:8083/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
