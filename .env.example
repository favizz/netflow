# =============================================
# TA-Flowmeter — Environment Variable Template
# Copy this file to .env and fill in values.
# Shared by all services (backend-ta, frontends)
# via each app's envDir config.
# =============================================

# ── Backend: App Server ────────────────────────────────────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080
NODE_ENV=development

# ── Backend: Database (MySQL 8.0) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=ta_db
# TypeORM connection pool — tune for expected concurrent units:
#   50 units  → pool 10   |  1 000 units → pool 30  |  10 000 units → pool 50
DB_POOL_SIZE=20
DB_POOL_IDLE_TIMEOUT=30000

# ── Backend: Redis (required for BullMQ telemetry queue) ──────────────────
# Use Docker: redis:7-alpine  |  Cloud: Upstash, Redis Labs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Number of parallel workers processing the telemetry queue.
# Rule of thumb: 1 worker per ~500 concurrent devices.
TELEMETRY_QUEUE_CONCURRENCY=10

# ── Backend: MQTT Broker ──────────────────────────────────────────────────
# TCP (IoT devices + NestJS backend):
MQTT_BROKER_URL=mqtt://localhost:1883
# Credentials used by the NestJS backend to connect to EMQX:
MQTT_USERNAME=netflow-backend
MQTT_PASSWORD=replace-with-strong-mqtt-password

# ── EMQX Authentication ───────────────────────────────────────────────────
# Set EMQX_AUTH_ENABLED=true in production to enforce per-client credentials.
# When false, EMQX runs in allow-anonymous mode (dev/test only).
EMQX_AUTH_ENABLED=false
EMQX_DASHBOARD_PASSWORD=netflow_admin
MQTT_AUTH_ENDPOINT=http://backend:5000
# Shared secret for ESP32 devices (all devices use the same password):
MQTT_DEVICE_SECRET=replace-with-strong-device-secret
# Shared secret for browser WebSocket clients:
MQTT_DASHBOARD_SECRET=replace-with-dashboard-ws-secret

# ── Backend: Auth (JWT) ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# ── Backend: Google OAuth ─────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=replace-with-google-client-id

# ── Backend: Admin ────────────────────────────────────────────────────────
# Legacy fallback key (still used in X-Api-Key header for non-OAuth admin tools)
ADMIN_API_KEY=replace-with-strong-admin-key

# ── Backend: Payment Gateway (Midtrans) ───────────────────────────────────
# dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
# Set to "true" for production; "false" uses Midtrans sandbox
MIDTRANS_IS_PRODUCTION=false

# ── Backend: Payment Webhook ──────────────────────────────────────────────
# Midtrans will sign webhooks with SHA-512(order_id + status_code + gross_amount + server_key)
# This secret is for your own additional HMAC layer if you add one.
PAYMENT_WEBHOOK_SECRET=replace-with-strong-webhook-secret
PAYMENT_WEBHOOK_MAX_SKEW_MS=300000
# Comma-separated Midtrans IPs; leave empty to skip IP check in local dev.
# Production IPs: 202.152.186.0/24, 103.28.144.0/24
PAYMENT_WEBHOOK_ALLOWED_IPS=

# ── Backend: ML Anomaly Service (Python FastAPI) ──────────────────────────
ML_SERVICE_URL=http://localhost:8000
# Seconds between batch anomaly scoring runs (0 = disabled)
ML_SCORING_INTERVAL_SECONDS=300
# Seconds between model retraining runs using real DB data (0 = disabled)
# Default: 86400 (daily). Set lower in dev to test quickly.
ML_RETRAINING_INTERVAL_SECONDS=86400

# ── Observability (OpenTelemetry) ─────────────────────────────────────────
# OTLP endpoint for distributed traces (Jaeger / Grafana Tempo).
# Leave empty to disable remote export (traces go to console in dev).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=netflow-backend
# Set to "console" to print spans to stdout (useful for local dev without Jaeger):
OTEL_TRACES_EXPORTER=

# ── Backend: Rate Limiting ────────────────────────────────────────────────
# Throttle window in milliseconds and max requests per window per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ── Frontend: Mobile & Dashboard (Vite) ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
# WebSocket MQTT (browser):
VITE_MQTT_BROKER_URL=ws://localhost:8083/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
