# App
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database — VPS MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ta_db

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883

# Auth
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Google OAuth — obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=replace-with-google-client-id

# Admin
ADMIN_API_KEY=replace-with-strong-admin-key

# Payment webhook security
PAYMENT_WEBHOOK_SECRET=replace-with-strong-webhook-secret
PAYMENT_WEBHOOK_MAX_SKEW_MS=300000
# Comma-separated trusted source IPs; leave empty in local dev
PAYMENT_WEBHOOK_ALLOWED_IPS=
